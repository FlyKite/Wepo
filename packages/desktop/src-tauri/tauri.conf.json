{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "微仓助手",
  "version": "1.0.0",
  "identifier": "com.wepo.assistant",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run setup:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "微仓助手",
        "width": 860,
        "height": 720,
        "minWidth": 680,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "resources": ["resources/importer/**/*"],
    "externalBin": ["binaries/node"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
